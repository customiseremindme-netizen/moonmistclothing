# ---------------------------------------------------------------
# Moon Mist — environment variables (copy to .env.local)
# Never commit real values. Add them in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Public site URL — used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: Supabase storage for enquiries.
# If BOTH are set, enquiries are saved to the `enquiries` table (see README).
# If not set, the form runs in demo mode and clearly says nothing was stored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
